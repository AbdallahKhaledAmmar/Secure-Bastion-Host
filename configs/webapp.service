[Unit]
Description=Simple Python HTTP server
After=network.target

[Service]
User=websvc
Group=websvc
WorkingDirectory=/opt/webapp
ExecStart=/usr/bin/python3 -m http.server 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
